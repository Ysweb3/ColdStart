<?xml version="1.0" encoding="UTF-8"?>

<!-- Resume Work HUD, option 5a (design_handoff_resume_hud/resume-hud-5a.html): black ground,
     neutral grey panels, #FF6500 resume, #E9E3DF text, blue only on checkpoint.
     The static parts live here; everything project-shaped is filled by HelloController, and
     every glyph slot (an empty StackPane) is drawn by Icons from code.
     HelloApplication hooks drag/resize/window buttons, because the stage is undecorated. -->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.shape.SVGPath?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.resumeone.HelloController"
      styleClass="shell" stylesheets="@hud.css" prefWidth="1000.0" prefHeight="640.0">

  <!-- ══ title bar: 38px, logo + wordmark, live dot, more, window buttons ══ -->
  <HBox fx:id="titleBar" styleClass="titlebar" alignment="CENTER_LEFT" spacing="10.0"
        minHeight="38.0" prefHeight="38.0" maxHeight="38.0">
    <padding><Insets left="12.0" right="8.0"/></padding>

    <Pane minWidth="15.0" prefWidth="15.0" maxWidth="15.0" minHeight="15.0" prefHeight="15.0" maxHeight="15.0">
      <Rectangle x="2.34" y="3.05" width="2.16" height="8.91" arcWidth="2.16" arcHeight="2.16" fill="#4B607F"/>
      <SVGPath content="M7.13 4.03 L12.38 7.5 L7.13 10.97 Z" fill="#F3701E" stroke="#F3701E" strokeWidth="1.22" strokeLineJoin="ROUND"/>
    </Pane>

    <HBox spacing="0.0" alignment="CENTER_LEFT">
      <Label styleClass="wordmark" text="coldstart"/>
      <Label styleClass="wordmark-dot" text="."/>
    </HBox>

    <Region HBox.hgrow="ALWAYS"/>

    <!-- "RESUMING atlas-api" stands in for the live dot during a run -->
    <HBox fx:id="titleState" alignment="CENTER_LEFT" spacing="8.0" visible="false" managed="false">
      <HBox.margin><Insets right="14.0"/></HBox.margin>
      <Region fx:id="titleStateDot" styleClass="dot-go" minWidth="7.0" prefWidth="7.0" maxWidth="7.0"
              minHeight="7.0" prefHeight="7.0" maxHeight="7.0"/>
      <Label fx:id="titleStateVerb" styleClass="title-verb" text="RESUMING"/>
      <Label fx:id="titleStateName" styleClass="title-name" text=""/>
    </HBox>

    <!-- live once a browser extension holds the socket; the tooltip names them -->
    <HBox fx:id="statusBox" alignment="CENTER_LEFT" spacing="8.0">
      <HBox.margin><Insets right="14.0"/></HBox.margin>
      <Region fx:id="statusDot" styleClass="dot-idle" minWidth="7.0" prefWidth="7.0" maxWidth="7.0"
              minHeight="7.0" prefHeight="7.0" maxHeight="7.0"/>
      <Label fx:id="statusLabel" styleClass="port" text=":8765"/>
    </HBox>

    <HBox spacing="2.0" alignment="CENTER_LEFT">
      <StackPane fx:id="btnMin" styleClass="iconbtn, no-cut" pickOnBounds="true"/>
      <StackPane fx:id="btnMax" styleClass="iconbtn, no-cut" pickOnBounds="true"/>
      <StackPane fx:id="btnClose" styleClass="iconbtn, no-cut" pickOnBounds="true"/>
    </HBox>
  </HBox>

  <HBox VBox.vgrow="ALWAYS">

    <!-- ══ sidebar: 212px PROJECTS list, or the 48px numbered rail (Settings / Ctrl+B).
         Widths and paddings live in hud.css so .rail-wide alone swaps them. -->
    <VBox fx:id="rail" styleClass="rail" alignment="TOP_CENTER">

      <HBox fx:id="railHead" styleClass="rail-head" spacing="8.0" alignment="BASELINE_LEFT">
        <Label styleClass="rail-label" text="PROJECTS"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="railCount" styleClass="rail-count" text="00"/>
      </HBox>

      <!-- one row per project, built by createProjectUI(): a 32x32 number, or folder + name when wide -->
      <VBox fx:id="projectList" styleClass="project-list" alignment="TOP_CENTER"/>

      <StackPane fx:id="btnNewProjectRail" styleClass="rail-btn, cut" pickOnBounds="true"/>

      <Region styleClass="rail-spine" minWidth="1.0" prefWidth="1.0" maxWidth="1.0" VBox.vgrow="ALWAYS"/>

      <HBox styleClass="rail-foot" alignment="CENTER" spacing="8.0">
        <Button fx:id="btnNewProjectWide" styleClass="btn-secondary, side-new" text="New project"
                maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
        <StackPane fx:id="btnSettings" styleClass="rail-btn, cut" pickOnBounds="true"/>
      </HBox>
    </VBox>

    <StackPane HBox.hgrow="ALWAYS">

      <!-- ══ a project is selected ═══════════════════════════════════════ -->
      <VBox fx:id="detailPane" spacing="16.0">
        <padding><Insets top="20.0" right="22.0" bottom="20.0" left="22.0"/></padding>

        <HBox alignment="TOP_LEFT" spacing="16.0">
          <VBox spacing="5.0" HBox.hgrow="ALWAYS">
            <Label fx:id="projectNameLabel" styleClass="project-name" text="—"/>
            <Label fx:id="projectPathLabel" styleClass="project-path" text=""/>
          </VBox>
          <!-- delete is per project, so it lives on the project, not in the window chrome -->
          <StackPane fx:id="btnDelete" styleClass="iconbtn" pickOnBounds="true"/>
        </HBox>

        <!-- the two verbs: RESUME takes the row, Checkpoint is a fixed 264. RESUME's notch is a
             clip cut by the controller, so its corner stays 18px at any width. -->
        <HBox spacing="12.0" minHeight="104.0" prefHeight="104.0" maxHeight="104.0">

          <HBox fx:id="btnResume" styleClass="resume" alignment="CENTER_LEFT" spacing="16.0" HBox.hgrow="ALWAYS">
            <padding><Insets left="22.0" right="22.0"/></padding>
            <StackPane fx:id="resumeGlyphBox"/>
            <Label styleClass="resume-word" text="RESUME"/>
            <Region HBox.hgrow="ALWAYS" minWidth="0.0"/>
            <!-- what one press brings back (renderDetail), and the shortcut, stated: Ctrl+R (installKeys) -->
            <VBox spacing="6.0" alignment="CENTER_RIGHT" minWidth="-Infinity">
              <Label fx:id="resumeCounts" styleClass="resume-hint" text=""/>
              <Label styleClass="resume-key" text="CTRL+R"/>
            </VBox>
          </HBox>

          <!-- the checkpoint block as it was (264px, slate border following the notch, a neutral
               divider, the bone bookmark), in layers so the handoff's confirmation can play over
               it: ring, bar, idle content, done content; the chevron segment sits on top so it
               takes its own clicks -->
          <StackPane fx:id="btnCheckpoint" styleClass="checkpoint"
                     minWidth="264.0" prefWidth="264.0" maxWidth="264.0">
            <Region fx:id="ckRing" styleClass="ck-ring" StackPane.alignment="CENTER_LEFT" mouseTransparent="true"
                    opacity="0" minWidth="28.0" prefWidth="28.0" maxWidth="28.0"
                    minHeight="28.0" prefHeight="28.0" maxHeight="28.0">
              <StackPane.margin><Insets left="19.0"/></StackPane.margin>
            </Region>
            <Region fx:id="ckBar" styleClass="ck-bar" StackPane.alignment="BOTTOM_CENTER" mouseTransparent="true"
                    minHeight="3.0" prefHeight="3.0" maxHeight="3.0" maxWidth="Infinity" translateY="3.0"/>
            <!-- idle, and the close states (renderCkPanel swaps glyph, word, hint and sub):
                 Closing · n of N apps, and Unsaved work / Save, then click again / names -->
            <HBox fx:id="ckIdle" alignment="CENTER_LEFT" spacing="16.0" mouseTransparent="true">
              <padding><Insets left="23.0" right="69.0"/></padding>
              <StackPane fx:id="ckGlyphBox" minWidth="24.0">
                <SVGPath fx:id="ckBookmark" content="M4 2 H16 V21 L10 16 L4 21 Z M19 4 V10 M16 7 H22"
                         fill="TRANSPARENT" stroke="#E9E3DF" strokeWidth="1.8"
                         strokeLineCap="ROUND" strokeLineJoin="ROUND"/>
              </StackPane>
              <VBox fx:id="ckText" spacing="8.0" alignment="CENTER_LEFT" minWidth="0.0">
                <Label fx:id="ckWord" styleClass="checkpoint-word" text="Checkpoint"/>
                <Label fx:id="ckHint" styleClass="ck-hint" text="Save, then click again"
                       visible="false" managed="false"/>
                <Label fx:id="checkpointSub" styleClass="checkpoint-sub" text=""/>
              </VBox>
            </HBox>
            <HBox fx:id="ckDone" alignment="CENTER_LEFT" spacing="16.0" mouseTransparent="true" opacity="0">
              <padding><Insets left="23.0" right="69.0"/></padding>
              <StackPane fx:id="ckDoneGlyphBox"/>
              <VBox spacing="8.0" alignment="CENTER_LEFT">
                <Label fx:id="ckDoneWord" styleClass="ck-done-word" text="Saved"/>
                <Label fx:id="ckDoneSub" styleClass="checkpoint-sub" text=""/>
              </VBox>
            </HBox>
            <Region styleClass="ck-divider" StackPane.alignment="CENTER_RIGHT" mouseTransparent="true"
                    minWidth="1.0" prefWidth="1.0" maxWidth="1.0" maxHeight="Infinity">
              <StackPane.margin><Insets right="52.0"/></StackPane.margin>
            </Region>
            <!-- split segment: 52px, full height, its own notch so the hover fill stays inside -->
            <StackPane fx:id="btnCheckpointMenu" styleClass="ck-menu" StackPane.alignment="CENTER_RIGHT" pickOnBounds="true"
                       minWidth="52.0" prefWidth="52.0" maxWidth="52.0" maxHeight="Infinity">
              <SVGPath styleClass="ck-glyph" content="M6 9 L12 15 L18 9"
                       fill="TRANSPARENT" strokeWidth="2.0" strokeLineCap="ROUND" strokeLineJoin="ROUND"/>
            </StackPane>
          </StackPane>
        </HBox>

        <!-- what gets saved: apps by category on the left, tabs by browser in the 288px column -->
        <!-- minHeight 0: the card always fits the window and its columns scroll instead -->
        <HBox styleClass="card" VBox.vgrow="ALWAYS" minHeight="0.0">
          <ScrollPane styleClass="tabs-scroll" fitToWidth="true" hbarPolicy="NEVER"
                      minHeight="0.0" HBox.hgrow="ALWAYS">
            <VBox fx:id="categoryRows" spacing="11.0">
              <padding><Insets top="14.0" right="16.0" bottom="14.0" left="16.0"/></padding>
            </VBox>
          </ScrollPane>

          <VBox styleClass="tabs-col" spacing="8.0" minWidth="288.0" prefWidth="288.0" maxWidth="288.0">
            <padding><Insets top="14.0" right="16.0" bottom="14.0" left="16.0"/></padding>
            <!-- scrolls rather than folding: minHeight 0 so a long list never pushes the
                 card taller than the window; the scrollbar is themed globally -->
            <ScrollPane styleClass="tabs-scroll" fitToWidth="true" hbarPolicy="NEVER"
                        minHeight="0.0" VBox.vgrow="ALWAYS">
              <!-- right 12: the rows' x stays clear of the scrollbar, not on its edge -->
              <VBox fx:id="tabsList" spacing="8.0">
                <padding><Insets right="12.0"/></padding>
              </VBox>
            </ScrollPane>
          </VBox>
        </HBox>

        <!-- "where was I", under everything. Saved on Enter, Esc or any click outside it; the
             resume screen shows it. Folded into "Add a note" while the project has none; the x
             removes it (showNoteStrip). -->
        <!-- the button is the strip's twin (same box, notch, pencil and text start) so opening
             it swaps one for the other without anything moving -->
        <Button fx:id="btnAddNote" styleClass="note-add" text="Add a note" graphicTextGap="12.0"
                maxWidth="Infinity" minHeight="40.0" prefHeight="40.0" maxHeight="40.0"/>
        <!-- 40 for one line, a line taller for two (the field's prefHeight, set in fitNote);
             the pencil and x stay centred on it -->
        <HBox fx:id="noteStrip" styleClass="note-strip, cut" alignment="CENTER_LEFT" spacing="12.0"
              minHeight="40.0" maxHeight="-Infinity" visible="false" managed="false">
          <padding><Insets top="6.0" left="14.0" bottom="6.0" right="4.0"/></padding>
          <StackPane fx:id="noteGlyphBox"/>
          <TextArea fx:id="noteField" styleClass="note-input" wrapText="true" HBox.hgrow="ALWAYS"
                    minHeight="20.0" prefHeight="20.0"/>
          <StackPane fx:id="btnNoteClose" styleClass="iconbtn" pickOnBounds="true"/>
        </HBox>
        <!-- handoff 1d: once a checkpoint lands, the note's place offers to close what it saved,
             for 6s (showOffer). It takes exactly the space of what it stands in for (the strip
             or "Add a note") and the strip's padding, so nothing on the card moves and its
             check sits where the note's pencil was. The 2px bar on its bottom edge is the
             countdown. -->
        <StackPane fx:id="ckOffer" styleClass="ck-offer" visible="false" managed="false">
          <HBox alignment="CENTER_LEFT" spacing="12.0">
            <padding><Insets left="14.0" right="4.0"/></padding>
            <StackPane fx:id="offerGlyphBox"/>
            <HBox spacing="10.0" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS" minWidth="0.0">
              <Label styleClass="ck-offer-title" text="Checkpoint saved. Done for now?" minWidth="-Infinity"/>
              <Label fx:id="offerSub" styleClass="ck-offer-sub" text="" minWidth="0.0"/>
            </HBox>
            <Button fx:id="btnOfferClose" styleClass="btn-offer" graphicTextGap="10.0"
                    minHeight="30.0" prefHeight="30.0" maxHeight="30.0" minWidth="-Infinity"/>
            <StackPane fx:id="btnOfferDismiss" styleClass="iconbtn, offer-x" pickOnBounds="true"
                       minWidth="32.0" prefWidth="32.0" maxWidth="32.0" minHeight="32.0" maxHeight="32.0"/>
          </HBox>
          <Region fx:id="offerBar" styleClass="ck-offer-bar" StackPane.alignment="BOTTOM_LEFT"
                  mouseTransparent="true" minHeight="2.0" prefHeight="2.0" maxHeight="2.0"/>
        </StackPane>
      </VBox>

      <!-- ══ nothing saved yet ═════════════════════════════════════════════ -->
      <!-- three steps on a 40px grid. The board is 22 x 13 cells, centred; every child sits on
           its cells (a framed block on the gridlines, a text cell 1px inside them, so its black
           ground masks the grid behind the words). drawEmptyGrid lines the grid up with the
           board's corner, so the steps stay on cells at any window size. -->
      <StackPane fx:id="emptyPane" visible="false" managed="false">
        <Pane fx:id="emptyGrid" mouseTransparent="true"/>
        <Pane fx:id="emptyBoard" minWidth="880.0" prefWidth="880.0" maxWidth="880.0"
              minHeight="520.0" prefHeight="520.0" maxHeight="520.0">

          <!-- a staircase: each step 6 x 3 cells, 2 columns after the last and starting on the row
               it ended. Between two steps, one elbow of cells: out of the bottom of one, along the
               grid, into the middle of the next one's left side, where a chevron points in. Each
               path wears its verb: checkpoint's fill into 02, resume's orange tint into 03. -->
          <Region styleClass="trail-ck" layoutX="121.0" layoutY="201.0" prefWidth="39.0" prefHeight="39.0"/>
          <Region styleClass="trail-ck" layoutX="121.0" layoutY="241.0" prefWidth="39.0" prefHeight="39.0"/>
          <Region styleClass="trail-ck" layoutX="161.0" layoutY="241.0" prefWidth="39.0" prefHeight="39.0"/>
          <Region styleClass="trail-ck" layoutX="201.0" layoutY="241.0" prefWidth="39.0" prefHeight="39.0"/>
          <Region styleClass="trail-ck" layoutX="241.0" layoutY="241.0" prefWidth="39.0" prefHeight="39.0"/>
          <StackPane fx:id="trailInto02" styleClass="trail-ck" layoutX="281.0" layoutY="241.0" prefWidth="39.0" prefHeight="39.0"/>
          <Region styleClass="trail-go" layoutX="441.0" layoutY="321.0" prefWidth="39.0" prefHeight="39.0"/>
          <Region styleClass="trail-go" layoutX="441.0" layoutY="361.0" prefWidth="39.0" prefHeight="39.0"/>
          <Region styleClass="trail-go" layoutX="481.0" layoutY="361.0" prefWidth="39.0" prefHeight="39.0"/>
          <Region styleClass="trail-go" layoutX="521.0" layoutY="361.0" prefWidth="39.0" prefHeight="39.0"/>
          <Region styleClass="trail-go" layoutX="561.0" layoutY="361.0" prefWidth="39.0" prefHeight="39.0"/>
          <StackPane fx:id="trailInto03" styleClass="trail-go" layoutX="601.0" layoutY="361.0" prefWidth="39.0" prefHeight="39.0"/>

          <VBox fx:id="emptyHead" styleClass="empty-cell" layoutX="1.0" layoutY="1.0" prefWidth="519.0" prefHeight="79.0"
                alignment="CENTER_LEFT" spacing="2.0">
            <Label styleClass="empty-title" text="Nothing to resume yet"/>
            <Label styleClass="empty-body" text="Three steps, once. After that it is one press."/>
          </VBox>

          <!-- TEMP: replays the entrance while it is being tuned; remove before shipping -->
          <HBox styleClass="empty-cell" layoutX="481.0" layoutY="1.0" prefWidth="399.0" prefHeight="79.0" alignment="CENTER_RIGHT">
            <Button fx:id="btnReplayEntrance" styleClass="btn-ghost" text="Replay entrance"
                    prefHeight="34.0" minHeight="34.0"/>
          </HBox>

          <VBox fx:id="step01" styleClass="step, step-now" layoutY="80.0" prefWidth="241.0" prefHeight="121.0">
            <padding><Insets top="14.0" right="16.0" bottom="14.0" left="16.0"/></padding>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
              <Label styleClass="step-num" text="01"/>
              <Label styleClass="step-body" text="Name it, pick its folder"/>
            </HBox>
            <Button fx:id="btnNewProjectEmpty" onAction="#onNewProjectClick" styleClass="btn-primary"
                    text="New project" prefHeight="42.0" minHeight="42.0">
              <VBox.margin><Insets top="14.0"/></VBox.margin>
            </Button>
          </VBox>

          <VBox fx:id="step02" styleClass="step, step-ck" layoutX="320.0" layoutY="200.0" prefWidth="241.0" prefHeight="121.0">
            <padding><Insets top="12.0" right="16.0" bottom="12.0" left="16.0"/></padding>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
              <Label styleClass="step-num" text="02"/>
              <StackPane fx:id="stepCkGlyph"/>
            </HBox>
            <Label styleClass="step-title" text="Checkpoint">
              <VBox.margin><Insets top="8.0"/></VBox.margin>
            </Label>
            <Label styleClass="step-body" wrapText="true" text="When you stop. Saves the open apps, tabs and folder.">
              <VBox.margin><Insets top="4.0"/></VBox.margin>
            </Label>
          </VBox>

          <!-- 02 and 03 are the two verbs as their blocks draw them: slate-edged Checkpoint,
               orange RESUME, both with the verbs' 14px notch -->
          <VBox fx:id="step03" styleClass="step, step-go" layoutX="640.0" layoutY="320.0" prefWidth="241.0" prefHeight="121.0">
            <padding><Insets top="12.0" right="16.0" bottom="12.0" left="16.0"/></padding>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
              <Label styleClass="step-num" text="03"/>
              <StackPane fx:id="stepResumeGlyph"/>
            </HBox>
            <Label styleClass="step-title" text="RESUME">
              <VBox.margin><Insets top="8.0"/></VBox.margin>
            </Label>
            <Label styleClass="step-body" wrapText="true" text="One press reopens all of it, tomorrow or next week.">
              <VBox.margin><Insets top="4.0"/></VBox.margin>
            </Label>
          </VBox>

          <Label fx:id="emptyFootLeft" styleClass="empty-cell, foot-note" layoutX="1.0" layoutY="481.0" prefWidth="399.0" prefHeight="39.0"
                 text="tabs come back through the coldstart browser extension"/>
          <Label fx:id="emptyFootRight" styleClass="empty-cell, empty-path" layoutX="481.0" layoutY="481.0" prefWidth="399.0" prefHeight="39.0"
                 alignment="CENTER_RIGHT" text="\%APPDATA%\Coldstart\projects.json"/>
        </Pane>
      </StackPane>

      <!-- Base view: replaces the project detail rather than covering it. -->
      <ScrollPane fx:id="settingsPane" styleClass="settings-scroll" fitToWidth="true" fitToHeight="true"
                  hbarPolicy="NEVER" visible="false" managed="false">
        <VBox spacing="0.0">
          <padding><Insets top="20.0" right="22.0" bottom="40.0" left="22.0"/></padding>

          <HBox alignment="CENTER_LEFT" spacing="16.0">
            <Label styleClass="settings-h1" text="Settings"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnSettingsBack" styleClass="btn-ghost" text="Back"
                    prefHeight="34.0" minHeight="34.0"/>
          </HBox>

          <!-- same topology as the project card: the user's options on the left, what the
               system reports beside it. The column grows so the divider runs the pane's height. -->
          <HBox spacing="24.0" VBox.vgrow="ALWAYS">
            <VBox.margin><Insets top="24.0"/></VBox.margin>

            <VBox spacing="0.0">
              <VBox spacing="12.0">
                <Label styleClass="rail-label" text="WINDOW">
                  <VBox.margin><Insets bottom="4.0"/></VBox.margin>
                </Label>
                <CheckBox fx:id="pinToggle" selected="true" text="Keep coldstart on top while resuming"/>
              </VBox>
              <VBox spacing="12.0">
                <VBox.margin><Insets top="24.0"/></VBox.margin>
                <Label styleClass="rail-label" text="MOTION">
                  <VBox.margin><Insets bottom="4.0"/></VBox.margin>
                </Label>
                <CheckBox fx:id="motionToggle" selected="true" text="Animate presses and panels"/>
              </VBox>
              <VBox spacing="12.0">
                <VBox.margin><Insets top="24.0"/></VBox.margin>
                <Label styleClass="rail-label" text="SIDEBAR">
                  <VBox.margin><Insets bottom="4.0"/></VBox.margin>
                </Label>
                <CheckBox fx:id="sidebarToggle" selected="true" text="Show project names in the sidebar"/>
              </VBox>
            </VBox>

            <!-- three stat rows from real state, re-rendered on socket events. Storage is the one that acts. -->
            <VBox styleClass="tabs-col" spacing="8.0" minWidth="288.0" prefWidth="288.0" HBox.hgrow="ALWAYS">
              <padding><Insets left="24.0"/></padding>
              <Label styleClass="rail-label" text="STATUS">
                <VBox.margin><Insets bottom="8.0"/></VBox.margin>
              </Label>
              <VBox fx:id="settingsRows" spacing="8.0"/>
            </VBox>
          </HBox>

          <Label fx:id="settingsFoot" styleClass="cat-foot" text="windows only · nothing syncs">
            <VBox.margin><Insets top="32.0"/></VBox.margin>
          </Label>
        </VBox>
      </ScrollPane>

      <!-- ══ resume in progress. Rows are built by renderResuming(). ══ -->
      <VBox fx:id="resumingPane" visible="false" managed="false">
        <HBox styleClass="strip" alignment="CENTER_LEFT" spacing="16.0"
              minHeight="48.0" prefHeight="48.0" maxHeight="48.0">
          <padding><Insets left="22.0" right="22.0"/></padding>
          <!-- no verb here: the title bar and the hero below already say RESUMING -->
          <Label fx:id="resumingCount" styleClass="strip-count" text="0 / ?"/>
          <StackPane fx:id="resumingMeter" styleClass="meter-track" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS"
                     minHeight="6.0" prefHeight="6.0" maxHeight="6.0">
            <Region fx:id="resumingFill" styleClass="meter-fill" maxWidth="-Infinity"
                    minHeight="6.0" prefHeight="6.0" maxHeight="6.0"/>
          </StackPane>
          <Label fx:id="resumingPct" styleClass="strip-pct" text="0%"/>
        </HBox>
        <VBox spacing="24.0" VBox.vgrow="ALWAYS">
          <padding><Insets top="20.0" right="22.0" bottom="20.0" left="22.0"/></padding>
          <VBox spacing="0.0">
            <Label styleClass="hero-word" text="RESUMING"/>
            <Label fx:id="resumingName" styleClass="hero-name" text=""/>
          </VBox>
          <VBox fx:id="resumingRows" spacing="8.0" maxWidth="720.0"/>
          <Region VBox.vgrow="ALWAYS"/>
          <HBox alignment="CENTER_LEFT" spacing="16.0">
            <Label fx:id="resumingSkipped" styleClass="foot-note" text=""/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnResumeStop" styleClass="btn-ghost" text="Stop" graphicTextGap="8.0"
                    prefHeight="34.0" minHeight="34.0"/>
          </HBox>
        </VBox>
      </VBox>

      <!-- ══ resume done. Auto-returns to the project in 5s unless something failed. ══ -->
      <VBox fx:id="restoredPane" visible="false" managed="false">
        <HBox styleClass="strip" alignment="CENTER_LEFT" spacing="16.0"
              minHeight="48.0" prefHeight="48.0" maxHeight="48.0">
          <padding><Insets left="22.0" right="22.0"/></padding>
          <Label fx:id="restoredCount" styleClass="strip-count" text="0 / 0" minWidth="-Infinity"/>
          <HBox fx:id="restoredMeter" styleClass="meter-track" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS"
                minHeight="6.0" prefHeight="6.0" maxHeight="6.0">
            <Region fx:id="restoredFill" styleClass="meter-fill" maxWidth="-Infinity"
                    minHeight="6.0" prefHeight="6.0" maxHeight="6.0"/>
            <Region fx:id="restoredFailFill" styleClass="meter-fail" maxWidth="-Infinity"
                    minHeight="6.0" prefHeight="6.0" maxHeight="6.0"/>
          </HBox>
          <Label fx:id="restoredTook" styleClass="strip-took" text="" minWidth="-Infinity"/>
        </HBox>
        <VBox spacing="24.0" VBox.vgrow="ALWAYS">
          <padding><Insets top="20.0" right="22.0" bottom="20.0" left="22.0"/></padding>
          <VBox spacing="0.0">
            <!-- RESUMED, STOPPED or NOT RESUMED: showRestored() says how the run ended -->
            <Label fx:id="restoredWord" styleClass="hero-word" text="RESUMED"/>
            <Label fx:id="restoredName" styleClass="hero-name" text=""/>
          </VBox>
          <!-- the project's note, back in front of you; hidden when there is none -->
          <Label fx:id="restoredNext" styleClass="hero-note" wrapText="true" maxWidth="720.0"
                 visible="false" managed="false"/>
          <Label fx:id="restoredSpec" styleClass="hero-spec" text=""/>
          <VBox fx:id="restoredRows" spacing="8.0" maxWidth="720.0"/>
          <Region VBox.vgrow="ALWAYS"/>
          <HBox fx:id="countdownTrack" styleClass="countdown-track" alignment="CENTER_LEFT" maxWidth="720.0"
                minHeight="3.0" prefHeight="3.0" maxHeight="3.0">
            <Region fx:id="countdownFill" styleClass="countdown-fill" maxWidth="-Infinity"
                    minHeight="3.0" prefHeight="3.0" maxHeight="3.0"/>
          </HBox>
          <HBox alignment="CENTER_LEFT" spacing="8.0" maxWidth="720.0">
            <Label fx:id="restoredNote" styleClass="foot-note" text=""/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnStayHere" styleClass="btn-ghost" text="Stay here"
                    prefHeight="34.0" minHeight="34.0"/>
            <!-- only after Stop: launches what was still queued -->
            <Button fx:id="btnResumeRest" styleClass="btn-secondary" text="Resume the rest" graphicTextGap="8.0"
                    prefHeight="34.0" minHeight="34.0" visible="false" managed="false"/>
            <Button fx:id="btnOpenProject" styleClass="btn-secondary" text="Open project" graphicTextGap="8.0"
                    contentDisplay="RIGHT" prefHeight="34.0" minHeight="34.0"/>
          </HBox>
        </VBox>
      </VBox>

      <!-- Scrims sit ON TOP of whichever base view is showing, so they stay last in the StackPane. -->
      <VBox fx:id="deletePane" styleClass="scrim" alignment="CENTER" visible="false" managed="false">
        <VBox styleClass="dialog" spacing="8.0" maxWidth="440.0" maxHeight="256.0">
          <padding><Insets top="24.0" right="24.0" bottom="16.0" left="24.0"/></padding>
          <Label styleClass="dialog-title" text="Delete project?"/>
          <Label fx:id="deleteSub" styleClass="dialog-sub" text=""/>
          <Label fx:id="deleteBody" styleClass="empty-body" wrapText="true" maxWidth="400.0">
            <VBox.margin><Insets top="8.0"/></VBox.margin>
          </Label>
          <HBox styleClass="inset-row" alignment="CENTER_LEFT" spacing="8.0">
            <padding><Insets top="8.0" right="8.0" bottom="8.0" left="8.0"/></padding>
            <StackPane fx:id="deleteFolderGlyph"/>
            <Label fx:id="deletePath" styleClass="project-path" text=""/>
          </HBox>
          <HBox alignment="CENTER_RIGHT" spacing="8.0">
            <VBox.margin><Insets top="8.0"/></VBox.margin>
            <Button fx:id="btnDeleteCancel" styleClass="btn-ghost" text="Cancel"
                    prefHeight="34.0" minHeight="34.0"/>
            <Button fx:id="btnDeleteOk" styleClass="btn-danger" text="Delete" prefHeight="34.0" minHeight="34.0"/>
          </HBox>
        </VBox>
      </VBox>

      <VBox fx:id="newProjectPane" styleClass="scrim" alignment="CENTER" visible="false" managed="false">
        <VBox styleClass="dialog" spacing="16.0" maxWidth="480.0" maxHeight="400.0">
          <padding><Insets top="24.0" right="24.0" bottom="16.0" left="24.0"/></padding>

          <Label styleClass="dialog-title" text="New project"/>

          <VBox spacing="8.0">
            <Label styleClass="cat-foot" text="Name"/>
            <TextField fx:id="npName" styleClass="input-name" promptText="ledger-api"/>
            <Label fx:id="npHint" styleClass="cat-foot" visible="false"/>
          </VBox>

          <VBox spacing="8.0">
            <Label styleClass="cat-foot" text="Folder · optional, for Claude and VS Code"/>
            <HBox styleClass="inset-row" alignment="CENTER_LEFT" spacing="8.0">
              <padding><Insets top="8.0" right="8.0" bottom="8.0" left="8.0"/></padding>
              <StackPane fx:id="npFolderGlyph"/>
              <Label fx:id="npFolder" styleClass="project-path" text="no folder chosen"
                     maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
              <Button fx:id="btnNpBrowse" styleClass="btn-ghost" text="Browse"
                      prefHeight="34.0" minHeight="34.0"/>
            </HBox>
          </VBox>

          <VBox styleClass="divider-top" spacing="8.0">
            <padding><Insets top="16.0"/></padding>
            <CheckBox fx:id="npCapture" selected="true" text="Checkpoint now"/>
            <Label fx:id="npCaptureHint" styleClass="cat-foot" wrapText="true" maxWidth="420.0"
                   text="no browser extension is connected, so no tabs"/>
          </VBox>

          <HBox alignment="CENTER_RIGHT" spacing="8.0">
            <Button fx:id="btnNpCancel" styleClass="btn-ghost" text="Cancel"
                    prefHeight="34.0" minHeight="34.0"/>
            <Button fx:id="btnNpCreate" styleClass="btn-checkpoint" text="Create + checkpoint"
                    graphicTextGap="8.0" prefHeight="34.0" minHeight="34.0"/>
          </HBox>
        </VBox>
      </VBox>

      <!-- Generic confirm. Copy and the verb button come from confirm() in the controller. -->
      <VBox fx:id="confirmPane" styleClass="scrim" alignment="CENTER" visible="false" managed="false">
        <VBox styleClass="dialog" spacing="8.0" maxWidth="440.0" maxHeight="230.0">
          <padding><Insets top="24.0" right="24.0" bottom="16.0" left="24.0"/></padding>
          <Label fx:id="confirmTitle" styleClass="dialog-title" text=""/>
          <Label fx:id="confirmSub" styleClass="dialog-sub" text=""/>
          <Label fx:id="confirmBody" styleClass="empty-body" wrapText="true" maxWidth="400.0">
            <VBox.margin><Insets top="8.0"/></VBox.margin>
          </Label>
          <HBox alignment="CENTER_RIGHT" spacing="8.0">
            <VBox.margin><Insets top="8.0"/></VBox.margin>
            <Button fx:id="btnConfirmCancel" styleClass="btn-ghost" text="Cancel"
                    prefHeight="34.0" minHeight="34.0"/>
            <Button fx:id="btnConfirmOk" styleClass="btn-checkpoint" text=""
                    prefHeight="34.0" minHeight="34.0"/>
          </HBox>
        </VBox>
      </VBox>
    </StackPane>
  </HBox>
</VBox>
