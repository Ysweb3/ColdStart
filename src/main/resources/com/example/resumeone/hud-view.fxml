<?xml version="1.0" encoding="UTF-8"?>

<!-- Resume Work HUD v2 — artboards 1b (home) and 1i (empty state), theme A "slate terminal".
     Source: claude.ai/design project b78487db, "Resume Work HUD v2.dc.html".
     The static parts live here; everything project-shaped is filled by HelloController.
     HelloApplication hooks drag/resize/window buttons, because the stage is undecorated. -->

<?import javafx.geometry.Insets?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.shape.SVGPath?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.resumeone.HelloController"
      styleClass="shell" stylesheets="@hud.css" prefWidth="1000.0" prefHeight="640.0">

  <!-- ══ title bar ══════════════════════════════════════════════════ -->
  <HBox fx:id="titleBar" styleClass="titlebar" alignment="CENTER_LEFT" spacing="8.0"
        minHeight="40.0" prefHeight="40.0" maxHeight="40.0">
    <padding><Insets left="16.0" right="8.0"/></padding>

    <Pane minWidth="15.0" prefWidth="15.0" maxWidth="15.0" minHeight="15.0" prefHeight="15.0" maxHeight="15.0">
      <Rectangle x="2.34" y="3.05" width="2.16" height="8.91" arcWidth="2.16" arcHeight="2.16" fill="#4B607F"/>
      <SVGPath content="M7.13 4.03 L12.38 7.5 L7.13 10.97 Z" fill="#F3701E" stroke="#F3701E" strokeWidth="1.22" strokeLineJoin="ROUND"/>
    </Pane>

    <HBox spacing="0.0" alignment="CENTER_LEFT">
      <Label styleClass="wordmark" text="coldstart"/>
      <Label styleClass="wordmark-dot" text="."/>
    </HBox>

    <Region HBox.hgrow="ALWAYS"/>

    <!-- 1e/1l: "RESUMING atlas-api" stands in for the port cluster during a run -->
    <HBox fx:id="titleState" alignment="CENTER_LEFT" spacing="8.0" visible="false" managed="false">
      <HBox.margin><Insets right="16.0"/></HBox.margin>
      <Region fx:id="titleStateDot" styleClass="dot-go" minWidth="7.0" prefWidth="7.0" maxWidth="7.0"
              minHeight="7.0" prefHeight="7.0" maxHeight="7.0"/>
      <Label fx:id="titleStateVerb" styleClass="title-verb" text="RESUMING"/>
      <Label fx:id="titleStateName" styleClass="title-name" text=""/>
    </HBox>

    <!-- live once a browser extension holds the socket -->
    <HBox fx:id="statusBox" alignment="CENTER_LEFT" spacing="8.0">
      <HBox.margin><Insets right="16.0"/></HBox.margin>
      <Region fx:id="statusDot" styleClass="dot-idle" minWidth="9.0" prefWidth="9.0" maxWidth="9.0"
              minHeight="9.0" prefHeight="9.0" maxHeight="9.0"/>
      <Label fx:id="statusLabel" styleClass="port" text=":8765"/>
    </HBox>

    <!-- the three window buttons are one tight cluster; the 32px boxes carry the gap -->
    <HBox spacing="0.0" alignment="CENTER_LEFT">
      <StackPane fx:id="btnMin" styleClass="winctl" pickOnBounds="true">
        <SVGPath styleClass="winctl-glyph,winctl-glyph-sm" content="M0 5 H10"/>
      </StackPane>
      <StackPane fx:id="btnMax" styleClass="winctl" pickOnBounds="true">
        <SVGPath styleClass="winctl-glyph,winctl-glyph-sm" content="M0.6 0.6 H9.4 V9.4 H0.6 Z"/>
      </StackPane>
      <StackPane fx:id="btnClose" styleClass="winctl" pickOnBounds="true">
        <SVGPath styleClass="winctl-glyph,winctl-glyph-sm" content="M0 0 L10 10 M10 0 L0 10"/>
      </StackPane>
    </HBox>
  </HBox>

  <HBox VBox.vgrow="ALWAYS">

    <!-- ══ rail (artboards 1e/1h/1i/1l): numbered projects, +, gear ═════ -->
    <VBox styleClass="rail" alignment="TOP_CENTER" spacing="8.0" minWidth="48.0" prefWidth="48.0" maxWidth="48.0">
      <padding><Insets top="16.0" bottom="16.0"/></padding>

      <!-- one 28x28 numbered button per project, built by createProjectUI(); name on hover -->
      <VBox fx:id="projectList" alignment="TOP_CENTER" spacing="8.0"/>

      <StackPane fx:id="btnNewProjectRail" styleClass="rail-btn" pickOnBounds="true">
        <SVGPath styleClass="winctl-glyph" scaleX="0.5833" scaleY="0.5833" content="M12 5 V19 M5 12 H19"/>
      </StackPane>

      <!-- the dotted spine from the artboards -->
      <Region styleClass="rail-spine" minWidth="1.0" prefWidth="1.0" maxWidth="1.0" VBox.vgrow="ALWAYS"/>

      <StackPane fx:id="btnSettings" styleClass="rail-btn" pickOnBounds="true">
        <SVGPath styleClass="winctl-glyph" scaleX="0.5833" scaleY="0.5833" content="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z M15 12 A3 3 0 1 1 9 12 A3 3 0 1 1 15 12"/>
      </StackPane>
    </VBox>

    <StackPane HBox.hgrow="ALWAYS">

      <!-- ══ 1b · a project is selected ═════════════════════════════ -->
      <VBox fx:id="detailPane" spacing="16.0">
        <padding><Insets top="24.0" right="24.0" bottom="24.0" left="24.0"/></padding>

        <HBox alignment="TOP_LEFT" spacing="16.0">
          <VBox spacing="8.0" HBox.hgrow="ALWAYS">
            <Label fx:id="projectNameLabel" styleClass="project-name" text="—"/>
            <Label fx:id="projectPathLabel" styleClass="project-path" text=""/>
          </VBox>
          <!-- delete is per project, so it lives on the project, not in the window chrome -->
          <StackPane fx:id="btnDelete" styleClass="winctl" pickOnBounds="true">
            <HBox.margin><Insets top="8.0"/></HBox.margin>
            <SVGPath styleClass="winctl-danger" scaleX="0.5833" scaleY="0.5833" content="M10 11 V17 M14 11 V17 M19 6 V20 A2 2 0 0 1 17 22 H7 A2 2 0 0 1 5 20 V6 M3 6 H21 M8 6 V4 A2 2 0 0 1 10 2 H14 A2 2 0 0 1 16 4 V6"/>
          </StackPane>
        </HBox>

        <!-- the two verbs: orange is only ever RESUME, slate only ever CHECKPOINT -->
        <HBox spacing="16.0" minHeight="104.0" prefHeight="104.0" maxHeight="104.0">

          <HBox fx:id="btnResume" styleClass="resume" alignment="CENTER_LEFT" spacing="16.0"
                minWidth="384.0" prefWidth="448.0" HBox.hgrow="ALWAYS">
            <padding><Insets left="24.0" right="24.0"/></padding>
            <SVGPath content="M6 4 L25 15 L6 26 Z" fill="#1A0C03" stroke="#1A0C03" strokeWidth="3.0" strokeLineJoin="ROUND"/>
            <VBox spacing="8.0" alignment="CENTER_LEFT">
              <Label styleClass="resume-word" text="RESUME"/>
              <Label fx:id="resumeSpec" styleClass="resume-spec" text=""/>
            </VBox>
          </HBox>

          <HBox fx:id="btnCheckpoint" styleClass="checkpoint" alignment="CENTER_LEFT" spacing="16.0"
                minWidth="280.0" prefWidth="280.0" maxWidth="280.0">
            <!-- 1px top/right/bottom so the split segment sits inside the 1px -rw-ck border -->
            <padding><Insets top="1.0" left="24.0" right="1.0" bottom="1.0"/></padding>
            <SVGPath content="M4 2 H16 V21 L10 16 L4 21 Z M19 4 V10 M16 7 H22"
                     fill="TRANSPARENT" stroke="#E8D8C9" strokeWidth="1.8"
                     strokeLineCap="ROUND" strokeLineJoin="ROUND"/>
            <VBox spacing="8.0" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
              <Label styleClass="checkpoint-word" text="Checkpoint"/>
              <Label fx:id="checkpointSub" styleClass="checkpoint-sub" text=""/>
            </VBox>
            <!-- split button: the right fifth opens the other kinds of checkpoint (add what is
                 missing: tabs / apps / both). Full height, its own notch, a 1px divider. The
                 click is consumed so the button underneath does not overwrite. -->
            <Region styleClass="ck-divider" minWidth="1.0" prefWidth="1.0" maxWidth="1.0"/>
            <StackPane fx:id="btnCheckpointMenu" styleClass="ck-menu" pickOnBounds="true"
                       minWidth="55.0" prefWidth="55.0" maxWidth="55.0">
              <HBox.margin><Insets left="-16.0"/></HBox.margin>
              <SVGPath styleClass="ck-glyph" content="M6 9 L12 15 L18 9" scaleX="0.8333" scaleY="0.8333"
                       fill="TRANSPARENT" strokeWidth="1.8" strokeLineCap="ROUND" strokeLineJoin="ROUND"/>
            </StackPane>
          </HBox>
        </HBox>

        <!-- fills the column, as 1b draws it; a taller window means more tabs shown -->
        <VBox styleClass="card" VBox.vgrow="ALWAYS">

          <!-- fixed height: the saved stamp (bold note + bar) must not nudge the column below,
               or the tab fold recounts by a row for the length of the animation -->
          <HBox styleClass="card-head" alignment="CENTER_LEFT" spacing="8.0"
                minHeight="48.0" prefHeight="48.0" maxHeight="48.0">
            <padding><Insets right="16.0" left="16.0"/></padding>
            <Label styleClass="card-title" text="WHAT GETS SAVED"/>
            <Region HBox.hgrow="ALWAYS"/>
            <!-- motion-checkpoint: the bar drops in beside the note once per save -->
            <Region fx:id="saveBar" styleClass="save-bar" minWidth="5.0" prefWidth="5.0" maxWidth="5.0"
                    minHeight="16.0" prefHeight="16.0" maxHeight="16.0" visible="false" managed="false"/>
            <Label fx:id="capturedNote" styleClass="card-note" text=""/>
          </HBox>

          <HBox VBox.vgrow="ALWAYS">
            <VBox fx:id="categoryRows" HBox.hgrow="ALWAYS" spacing="8.0">
              <padding><Insets top="16.0" right="16.0" bottom="16.0" left="16.0"/></padding>
            </VBox>

            <!-- side padding lives inside the scroll viewport (on the list and the header),
                 not on the column: the viewport clips, and the live dot's glow needs the room;
                 it also keeps each row's x off the scrollbar -->
            <VBox styleClass="tabs-col" spacing="8.0" minWidth="288.0" prefWidth="288.0" maxWidth="288.0">
              <padding><Insets top="16.0" right="8.0" bottom="16.0" left="8.0"/></padding>
              <HBox alignment="BOTTOM_LEFT" spacing="8.0">
                <padding><Insets right="18.0" left="8.0"/></padding>
                <Label styleClass="rail-label" text="TABS"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="tabsCount" styleClass="rail-count" text="0"/>
              </HBox>
              <!-- scrolls rather than folding: minHeight 0 so a long list never pushes the
                   card taller than the window; the scrollbar is themed globally -->
              <ScrollPane styleClass="tabs-scroll" fitToWidth="true" hbarPolicy="NEVER"
                          minHeight="0.0" VBox.vgrow="ALWAYS">
                <VBox fx:id="tabsList" spacing="8.0">
                  <padding><Insets top="2.0" right="8.0" bottom="2.0" left="8.0"/></padding>
                </VBox>
              </ScrollPane>
            </VBox>
          </HBox>
        </VBox>
      </VBox>

      <!-- ══ 1i · nothing saved yet ═════════════════════════════════ -->
      <!-- spacing is the tightest gap (title→body); every wider gap is a top margin,
           because a flat 20 between all six children read as an unstructured stack. -->
      <VBox fx:id="emptyPane" alignment="CENTER" spacing="8.0" visible="false" managed="false">
        <padding><Insets left="40.0" right="40.0"/></padding>

        <SVGPath content="M8 3 H28 V33 L18 25 L8 33 Z M33 7 V17 M28 12 H38"
                 fill="TRANSPARENT" stroke="#3A4C66" strokeWidth="2.0"
                 strokeLineCap="ROUND" strokeLineJoin="ROUND">
          <VBox.margin><Insets top="16.0"/></VBox.margin>
        </SVGPath>
        <Label styleClass="empty-title" text="Nothing to resume yet">
          <VBox.margin><Insets top="8.0"/></VBox.margin>
        </Label>
        <Label styleClass="empty-body" maxWidth="460.0" wrapText="true" textAlignment="CENTER"
               text="Create a project, point it at a folder, and hit Checkpoint when you stop for the day."/>

        <HBox alignment="CENTER" spacing="8.0">
          <VBox.margin><Insets top="16.0"/></VBox.margin>
          <Button fx:id="btnNewProjectEmpty" onAction="#onNewProjectClick" styleClass="btn-checkpoint"
                  text="+   New project" prefHeight="40.0" minHeight="40.0"/>
        </HBox>

        <Label styleClass="cat-foot" text="install the browser extension to record tabs · it connects on :8765">
          <VBox.margin><Insets top="8.0"/></VBox.margin>
        </Label>
      </VBox>

      <!-- Base view: replaces the project detail rather than covering it. -->
      <ScrollPane fx:id="settingsPane" styleClass="settings-scroll" fitToWidth="true" fitToHeight="true"
                  hbarPolicy="NEVER" visible="false" managed="false">
        <VBox spacing="0.0">
          <padding><Insets top="24.0" right="32.0" bottom="40.0" left="32.0"/></padding>

          <HBox alignment="CENTER_LEFT" spacing="16.0">
            <Label styleClass="settings-h1" text="Settings"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnSettingsBack" styleClass="btn-ghost" text="Back"
                    prefHeight="32.0" minHeight="32.0"/>
          </HBox>

          <!-- same topology as the project card: what the app does on the left, what the
               system reports beside it. The behaviour rows are plain check + label, filled by
               initialize(): a disabled checkbox read as "locked", and Modena faded it to 2:1.
               The column grows so the divider runs the pane's height like the card's TABS column. -->
          <HBox spacing="24.0" VBox.vgrow="ALWAYS">
            <VBox.margin><Insets top="24.0"/></VBox.margin>

            <VBox spacing="0.0">
              <VBox spacing="12.0">
                <Label styleClass="rail-label" text="WHAT IS CAPTURED">
                  <VBox.margin><Insets bottom="4.0"/></VBox.margin>
                </Label>
                <VBox fx:id="captureRows" spacing="12.0"/>
              </VBox>
              <VBox spacing="12.0">
                <VBox.margin><Insets top="24.0"/></VBox.margin>
                <Label styleClass="rail-label" text="HOW IT RESUMES">
                  <VBox.margin><Insets bottom="4.0"/></VBox.margin>
                </Label>
                <VBox fx:id="resumeRows" spacing="12.0"/>
              </VBox>
              <Label styleClass="cat-foot" text="fixed for now · nothing here is adjustable yet">
                <VBox.margin><Insets top="24.0"/></VBox.margin>
              </Label>
            </VBox>

            <!-- 1h: three stat rows from real state, re-rendered on socket events. Storage is the one that acts. -->
            <VBox styleClass="tabs-col" spacing="8.0" minWidth="288.0" prefWidth="288.0" HBox.hgrow="ALWAYS">
              <padding><Insets left="24.0"/></padding>
              <Label styleClass="rail-label" text="STATUS">
                <VBox.margin><Insets bottom="8.0"/></VBox.margin>
              </Label>
              <VBox fx:id="settingsRows" spacing="8.0"/>
            </VBox>
          </HBox>

          <Label fx:id="settingsFoot" styleClass="cat-foot" text="windows only · nothing syncs">
            <VBox.margin><Insets top="32.0"/></VBox.margin>
          </Label>
        </VBox>
      </ScrollPane>

      <!-- ══ 1e · resume in progress. Rows are built by renderResuming(). ══ -->
      <VBox fx:id="resumingPane" visible="false" managed="false">
        <HBox styleClass="strip" alignment="CENTER_LEFT" spacing="16.0"
              minHeight="48.0" prefHeight="48.0" maxHeight="48.0">
          <padding><Insets left="24.0" right="24.0"/></padding>
          <Label styleClass="strip-verb" text="LAUNCHING"/>
          <Label fx:id="resumingCount" styleClass="strip-count" text="0 / ?"/>
          <HBox fx:id="resumingMeter" styleClass="meter-track" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS"
                minHeight="6.0" prefHeight="6.0" maxHeight="6.0">
            <Region fx:id="resumingFill" styleClass="meter-fill" maxWidth="-Infinity"
                    minHeight="6.0" prefHeight="6.0" maxHeight="6.0"/>
          </HBox>
          <Label fx:id="resumingPct" styleClass="strip-pct" text="0%"/>
        </HBox>
        <VBox spacing="24.0" VBox.vgrow="ALWAYS">
          <padding><Insets top="24.0" right="32.0" bottom="24.0" left="32.0"/></padding>
          <VBox spacing="0.0">
            <Label styleClass="hero-word" text="RESUMING"/>
            <Label fx:id="resumingName" styleClass="hero-name" text=""/>
          </VBox>
          <VBox fx:id="resumingRows" spacing="8.0" maxWidth="720.0"/>
          <Region VBox.vgrow="ALWAYS"/>
          <HBox alignment="CENTER_LEFT" spacing="16.0">
            <Label fx:id="resumingSkipped" styleClass="foot-note" text=""/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnResumeStop" styleClass="btn-ghost" text="Stop" graphicTextGap="8.0"
                    prefHeight="32.0" minHeight="32.0"/>
          </HBox>
        </VBox>
      </VBox>

      <!-- ══ 1l · resume done. Auto-returns to the project in 3s. ═════════ -->
      <VBox fx:id="restoredPane" visible="false" managed="false">
        <HBox styleClass="strip" alignment="CENTER_LEFT" spacing="16.0"
              minHeight="48.0" prefHeight="48.0" maxHeight="48.0">
          <padding><Insets left="24.0" right="24.0"/></padding>
          <Label styleClass="strip-verb" text="RESTORED"/>
          <Label fx:id="restoredCount" styleClass="strip-count" text="0 / 0"/>
          <HBox fx:id="restoredMeter" styleClass="meter-track" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS"
                minHeight="6.0" prefHeight="6.0" maxHeight="6.0">
            <Region fx:id="restoredFill" styleClass="meter-fill" maxWidth="-Infinity"
                    minHeight="6.0" prefHeight="6.0" maxHeight="6.0"/>
            <Region fx:id="restoredFailFill" styleClass="meter-fail" maxWidth="-Infinity"
                    minHeight="6.0" prefHeight="6.0" maxHeight="6.0"/>
          </HBox>
          <Label fx:id="restoredTook" styleClass="strip-took" text=""/>
        </HBox>
        <VBox spacing="24.0" VBox.vgrow="ALWAYS">
          <padding><Insets top="24.0" right="32.0" bottom="24.0" left="32.0"/></padding>
          <VBox spacing="0.0">
            <Label styleClass="hero-word" text="ENVIRONMENT"/>
            <Label styleClass="hero-name" text="RESTORED"/>
          </VBox>
          <Label fx:id="restoredSpec" styleClass="hero-spec" text=""/>
          <VBox fx:id="restoredRows" spacing="8.0" maxWidth="720.0"/>
          <Region VBox.vgrow="ALWAYS"/>
          <HBox fx:id="countdownTrack" styleClass="countdown-track" alignment="CENTER_LEFT" maxWidth="720.0"
                minHeight="3.0" prefHeight="3.0" maxHeight="3.0">
            <Region fx:id="countdownFill" styleClass="countdown-fill" maxWidth="-Infinity"
                    minHeight="3.0" prefHeight="3.0" maxHeight="3.0"/>
          </HBox>
          <HBox alignment="CENTER_LEFT" spacing="8.0" maxWidth="720.0">
            <Label fx:id="restoredNote" styleClass="foot-note" text=""/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnStayHere" styleClass="btn-ghost" text="Stay here"
                    prefHeight="32.0" minHeight="32.0"/>
            <Button fx:id="btnOpenProject" styleClass="btn-checkpoint" text="Open project" graphicTextGap="8.0"
                    prefHeight="32.0" minHeight="32.0"/>
          </HBox>
        </VBox>
      </VBox>

      <!-- Scrims sit ON TOP of whichever base view is showing, so they stay last in the
           StackPane. Per motion-checkpoint the checkpoint confirmation is not one of them:
           it is the save-bar dropping into the card head. -->
      <!-- DeleteDialog from the design kit's Dialogs.jsx -->
      <VBox fx:id="deletePane" styleClass="scrim" alignment="CENTER" visible="false" managed="false">
        <VBox styleClass="dialog" spacing="8.0" maxWidth="440.0" maxHeight="256.0">
          <padding><Insets top="24.0" right="24.0" bottom="16.0" left="24.0"/></padding>
          <Label styleClass="dialog-title" text="Delete project?"/>
          <Label styleClass="dialog-sub" text="removes the checkpoint, not the folder"/>
          <Label fx:id="deleteBody" styleClass="empty-body" wrapText="true" maxWidth="400.0">
            <VBox.margin><Insets top="8.0"/></VBox.margin>
          </Label>
          <HBox styleClass="inset-row" alignment="CENTER_LEFT" spacing="8.0">
            <padding><Insets top="8.0" right="8.0" bottom="8.0" left="8.0"/></padding>
            <SVGPath content="M1 3 L6 3 L7.5 4.8 L14 4.8 L14 12.5 L1 12.5 Z" fill="#6F655C"/>
            <Label fx:id="deletePath" styleClass="project-path" text=""/>
          </HBox>
          <HBox alignment="CENTER_RIGHT" spacing="8.0">
            <VBox.margin><Insets top="8.0"/></VBox.margin>
            <Button fx:id="btnDeleteCancel" styleClass="btn-ghost" text="Cancel"
                    prefHeight="32.0" minHeight="32.0"/>
            <Button fx:id="btnDeleteOk" styleClass="btn-danger" text="Delete" prefHeight="32.0" minHeight="32.0"/>
          </HBox>
        </VBox>
      </VBox>

      <!-- NewProjectDialog from the design kit's Dialogs.jsx -->
      <VBox fx:id="newProjectPane" styleClass="scrim" alignment="CENTER" visible="false" managed="false">
        <VBox styleClass="dialog" spacing="16.0" maxWidth="480.0" maxHeight="400.0">
          <padding><Insets top="24.0" right="24.0" bottom="16.0" left="24.0"/></padding>

          <VBox spacing="8.0">
            <Label styleClass="dialog-title" text="New project"/>
            <Label styleClass="dialog-sub" text="captures the apps and tabs open right now"/>
          </VBox>

          <VBox spacing="8.0">
            <Label styleClass="cat-foot" text="Project name"/>
            <TextField fx:id="npName" styleClass="input-name" promptText="ledger-api"/>
            <Label styleClass="cat-foot" text="shown in the sidebar &#8212; used as the key in projects.json"/>
          </VBox>

          <VBox spacing="8.0">
            <Label styleClass="cat-foot" text="Project folder"/>
            <HBox styleClass="inset-row" alignment="CENTER_LEFT" spacing="8.0">
              <padding><Insets top="8.0" right="8.0" bottom="8.0" left="8.0"/></padding>
              <SVGPath content="M1 3 L6 3 L7.5 4.8 L14 4.8 L14 12.5 L1 12.5 Z" fill="#6F655C"/>
              <Label fx:id="npFolder" styleClass="project-path" text="no folder chosen"
                     maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
              <Button fx:id="btnNpBrowse" styleClass="btn-ghost" text="Browse"
                      prefHeight="32.0" minHeight="32.0"/>
            </HBox>
          </VBox>

          <VBox styleClass="divider-top" spacing="8.0">
            <padding><Insets top="16.0"/></padding>
            <CheckBox fx:id="npCapture" selected="true" text="Checkpoint immediately"/>
            <Label styleClass="cat-foot" wrapText="true" maxWidth="420.0"
                   text="records every window with a visible title, plus tabs from connected browsers"/>
          </VBox>

          <HBox alignment="CENTER_RIGHT" spacing="8.0">
            <Button fx:id="btnNpCancel" styleClass="btn-ghost" text="Cancel"
                    prefHeight="32.0" minHeight="32.0"/>
            <Button fx:id="btnNpCreate" styleClass="btn-checkpoint" text="Create + checkpoint"
                    graphicTextGap="8.0" prefHeight="32.0" minHeight="32.0">
              <graphic>
                <SVGPath styleClass="btn-glyph" scaleX="0.5833" scaleY="0.5833" content="M19 21 L12 17 L5 21 V5 A2 2 0 0 1 7 3 H14 A2 2 0 0 1 16 5 V11 M16 9 H22 M19 6 V12"/>
              </graphic>
            </Button>
          </HBox>
        </VBox>
      </VBox>

      <!-- Generic confirm. Copy and the verb button come from confirm() in the controller. -->
      <VBox fx:id="confirmPane" styleClass="scrim" alignment="CENTER" visible="false" managed="false">
        <VBox styleClass="dialog" spacing="8.0" maxWidth="440.0" maxHeight="230.0">
          <padding><Insets top="24.0" right="24.0" bottom="16.0" left="24.0"/></padding>
          <Label fx:id="confirmTitle" styleClass="dialog-title" text=""/>
          <Label fx:id="confirmSub" styleClass="dialog-sub" text=""/>
          <Label fx:id="confirmBody" styleClass="empty-body" wrapText="true" maxWidth="400.0">
            <VBox.margin><Insets top="8.0"/></VBox.margin>
          </Label>
          <HBox alignment="CENTER_RIGHT" spacing="8.0">
            <VBox.margin><Insets top="8.0"/></VBox.margin>
            <Button fx:id="btnConfirmCancel" styleClass="btn-ghost" text="Cancel"
                    prefHeight="32.0" minHeight="32.0"/>
            <Button fx:id="btnConfirmOk" styleClass="btn-checkpoint" text=""
                    prefHeight="32.0" minHeight="32.0"/>
          </HBox>
        </VBox>
      </VBox>
    </StackPane>
  </HBox>
</VBox>
